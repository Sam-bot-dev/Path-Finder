# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ChatGPT / Experiential Labs API Gateway
EXPERIENTIAL_API_KEY=your_xpl_api_key_here
OPENAI_API_KEY=your_openai_or_xpl_key_here
EXPERIENTIAL_BASE_URL=https://api.experientiallabs.ai/v1

# Optional YouTube Search API Key
YOUTUBE_API_KEY=

# Server Configuration
PORT=3001
VITE_API_BASE_URL=

# Firebase Web Configuration for Google Auth
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
